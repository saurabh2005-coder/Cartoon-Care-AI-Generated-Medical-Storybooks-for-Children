TTS_INTEGRATION_SUMMARY.txt
WORD_DOCUMENT_GUIDE.md

# ── Report generation files ───────────────────────────────────────
generate_report*.py
Final_Project_Report_CartoonCare_Part*.md
Final_Project_Report_CartoonCare.md

# ── Temporary Word documents ──────────────────────────────────────
~$*.docx
*.tmp
Cartoon_Care_Complete_Report.docx
final_report.docx

# ── IDE and system files ──────────────────────────────────────────
.vscode/
.idea/
.kiro/
.DS_Store
Thumbs.db
desktop.ini

# ── Python cache ──────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd

# ── Logs ──────────────────────────────────────────────────────────
*.log

# ── Keep these files ──────────────────────────────────────────────
!README.md
