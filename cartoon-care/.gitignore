# ═══════════════════════════════════════════════════════════════
# CARTOON CARE - .gitignore
# Files and directories to exclude from version control
# ═══════════════════════════════════════════════════════════════

# ── Python ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.pyc

# ── Virtual environments ──────────────────────────────────────────
venv/
env/
.venv/
.env/
ENV/
env.bak/
venv.bak/

# ── Environment variables (SECRETS - NEVER COMMIT) ───────────────
backend/.env
.env
.env.local
.env.*.local

# ── Database (generated at runtime) ──────────────────────────────
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
*.sqlite
*.sqlite3

# ── Generated outputs (images, PDFs, stories) ────────────────────
backend/outputs/
outputs/
backend/services/fonts/
*_compressed.jpg
*_compressed.png

# ── AI Models (too large for git - download separately) ──────────
backend/models/
models/
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.onnx
*.pb

# ── LoRA training dataset (779 images - too large) ───────────────
backend/ai/lora_training/dataset/images/
backend/ai/lora_training/dataset/processed/

# ── Frontend build artifacts ──────────────────────────────────────
frontend/dist/
frontend/build/
frontend/node_modules/
frontend/.vite/
frontend/.cache/

# ── Node.js ───────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
.pnpm-debug.log*

# ── OS files ──────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ── IDE and Editor files ──────────────────────────────────────────
.vscode/
.idea/
.kiro/
*.swp
*.swo
*.swn
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# ── Logs ──────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ── Test files and coverage ───────────────────────────────────────
backend/test_*.py
test_*.py
*_test.py
.coverage
.pytest_cache/
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# ── Documentation (keep only essential) ───────────────────────────
*.md.backup
*_BACKUP.md
*_OLD.md
NOTES.md
TODO.md
TEMP*.md

# ── Report files (keep final version only) ───────────────────────
*_Part*.md
generate_report*.py
~$*.docx
*.tmp

# ── Temporary files ───────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.backup
*.old
*~

# ── Compiled files ────────────────────────────────────────────────
*.com
*.class
*.dll
*.exe
*.o
*.so

# ── Package files ─────────────────────────────────────────────────
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# ── Media files (if not needed for deployment) ───────────────────
# Uncomment if you don't need these in repo
# *.jpg
# *.jpeg
# *.png
# *.gif
# *.mp4
# *.mov

# ── Jupyter Notebooks (if used for experiments) ──────────────────
.ipynb_checkpoints/
*.ipynb

# ── Docker (if used) ──────────────────────────────────────────────
*.dockerignore
docker-compose.override.yml

# ── CI/CD artifacts ───────────────────────────────────────────────
.github/workflows/*.log

# ── Keep these files (explicitly tracked) ─────────────────────────
!backend/.env.example
!README.md
!LICENSE
!.gitignore
